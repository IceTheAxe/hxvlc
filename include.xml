<?xml version="1.0" encoding="UTF-8"?>
<extension
	xmlns="http://lime.openfl.org/project/1.0.4"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

	<section if="windows || mac">
		<library name="libvlc" preload="false" />
	</section>

	<section if="windows">
		<!-- Windows on ARM64：libvlc 3.0.24 官方 arm64 构建（取自 VideoLAN.LibVLC.Windows 3.0.24 NuGet）。
		     不带 plugins.dat —— hxvlc/impl/Instance.hx 检测到缓存缺失会传 --reset-plugins-cache 让 libvlc 重扫。 -->
		<section if="HXCPP_ARM64 || arm64">
			<assets path="project/vlc/lib/Windows/arm64" rename="" include="*.dll" library="libvlc" />
			<assets path="project/vlc/plugins/Windows/arm64" rename="plugins" include="*.dll" library="libvlc" />
		</section>
		<section unless="HXCPP_ARM64 || arm64">
			<assets path="project/vlc/lib/Windows" rename="" include="*.dll" library="libvlc" />
			<assets path="project/vlc/plugins/Windows" rename="plugins" include="*.dll" library="libvlc" />
			<assets path="project/vlc/plugins/Windows/plugins.dat" rename="plugins/plugins.dat" library="libvlc" />
		</section>
	</section>

	<section if="mac">
		<assets path="project/vlc/lib/MacOS" rename="../MacOS/lib" include="*.dylib" library="libvlc" />
		<assets path="project/vlc/plugins/MacOS" rename="../MacOS/plugins" include="*.dylib" library="libvlc" />
		<assets path="project/vlc/plugins/MacOS/plugins.dat" rename="../MacOS/plugins/plugins.dat" library="libvlc" />
	</section>

	<section if="android">
		<ndll name="c++_shared" dir="project/vlc/lib" />
		<ndll name="vlc" dir="project/vlc/lib" />
	</section>

	<section if="ios">
		<dependency name="CFNetwork.framework" />
		<dependency name="CoreFoundation.framework" />
		<dependency name="CoreMedia.framework" />
		<dependency name="CoreText.framework" />
		<dependency name="CoreVideo.framework" />
		<dependency name="Security.framework" />
		<dependency name="VideoToolbox.framework" />
		<dependency name="CoreImage.framework" />

		<dependency name="libiconv.tbd" />
	</section>

	<sample path="samples" />

	<source path="source" />
</extension>